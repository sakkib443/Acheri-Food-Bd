# ============================================================
#  Acheri Food Bd — PRODUCTION .env (cPanel / shared hosting)
#  Copy this file to ".env" on the server and fill the values.
# ============================================================

APP_NAME="Acheri Food Bd"
APP_ENV=production
# Copy APP_KEY exactly from your LOCAL .env (the base64:... value),
# or run `php artisan key:generate` if you have Terminal access.
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ---- MySQL (create the DB + user in cPanel → MySQL Databases) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpanelusername_acheri
DB_USERNAME=cpanelusername_acheri
DB_PASSWORD=your_database_password

# ---- File-based drivers: safest on shared hosting (no queue worker) ----
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---- Store contact info (already set in config/site.php as defaults) ----
SITE_WHATSAPP=8801719507693
SITE_PHONE=01719507693
SITE_EMAIL=santahardigitalpostoffice@gmail.com
SITE_ADDRESS="Bogura, Dhaka, Bangladesh"
SITE_DELIVERY_CHARGE=60

# ---- Mail: keep as log unless you set up SMTP in cPanel ----
MAIL_MAILER=log
MAIL_FROM_ADDRESS="santahardigitalpostoffice@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- One-time installer switch (see DEPLOY-CPANEL.md) ----
# Set to true only while running /__setup, then set back to false.
ALLOW_WEB_SETUP=false
